{
  "name": "astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "predev": "npx kill-port 3000 || true",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "astro": "astro",
    "setup:repo": "bash scripts/setup-repo.sh",
    "cf-typegen": "wrangler types",
    "build:push": "bash scripts/build-and-push.sh",
    "create:pr": "bash scripts/create-pr.sh",
    "build:docs": "node ./scripts/build-master-doc.mjs",
    "cleanup": "rm -rf /tmp/* /var/tmp/* /root/.npm /root/.cache /root/.local /app/lost+found/* /app/dist 2>/dev/null || true && echo 'Cleanup complete!' && df -h / | tail -1",
    "sync:main": "bash scripts/sync-main-to-dev.sh"
  },
  "dependencies": {
    "@astrojs/cloudflare": "13.5.0",
    "@astrojs/react": "4.4.2",
    "@google-cloud/bigquery": "8.3.0",
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "apache-arrow": "21.1.0",
    "astro": "6.3.1",
    "astro-icon": "1.1.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "0.577.0",
    "next-themes": "0.4.6",
    "parquetjs-lite": "0.8.7",
    "react": "19.1.1",
    "react-day-picker": "9.14.0",
    "react-dom": "19.1.1",
    "react-hook-form": "7.75.0",
    "react-resizable-panels": "3.0.6",
    "recharts": "2.15.4",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "vaul": "1.1.2",
    "webflow-api": "3.3.4",
    "zod": "4.0.13"
