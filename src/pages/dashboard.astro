---
import MainLayout from '../layouts/main.astro';
import { ClientDashboard } from '../components/ClientDashboard';
import { baseUrl } from '../lib/base-url';
---

<MainLayout>
  <!-- React component -->
  <ClientDashboard client:only="react" />
  
  <noscript>
    <div class="min-h-screen bg-background flex items-center justify-center p-8">
      <div class="text-center">
        <h1 class="text-2xl font-bold mb-4">JavaScript Required</h1>
        <p class="text-muted-foreground">Please enable JavaScript to use the dashboard.</p>
      </div>
    </div>
  </noscript>
</MainLayout>
